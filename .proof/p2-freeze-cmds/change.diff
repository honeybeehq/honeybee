-/** HSR run-dir meta (old src/hsr/runDir.ts): host/child pids + the harness session id. */
-export interface HsrMeta {
-  hostPid: number | null;
-  hostStartedAt: number | null;
-  childPid: number | null;
-  childStartedAt: number | null;
-  sessionId: string | null;
-}
