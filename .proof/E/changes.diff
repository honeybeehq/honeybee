+  const windows = applicableWindows(candidate, policy.model);
+  if (!quota || !Number.isFinite(quota.fetchedAt) || quota.fetchedAt > policy.now + 60_000
+    || policy.now - quota.fetchedAt > policy.quotaFreshMs || windows.length === 0
