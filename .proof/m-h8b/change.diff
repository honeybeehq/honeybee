-          // are not pane events. Lifecycle stays owned by the adapter/core.
-          return [];
-      }
-    },
-    flush(): TranscriptProjectedEvent[] {
-      startedItems.clear();
-      forkRequestIds.clear();
-      return [];
-    },
-  };
