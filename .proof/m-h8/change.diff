-const format =
-  env.TMUX_STUB_TRANSCRIPT || (style === "hooks" ? "claude" : style === "notify" ? "codex" : "grok");
-
-if (env.TMUX_STUB_IGNORE_SIGTERM === "1") {
-  process.on("SIGTERM", () => console.log("ignoring SIGTERM"));
