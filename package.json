{
  "name": "honeybee",
  "version": "0.0.1",
  "description": "On-demand tmux cockpit for interactive AI bees; CLI: hive.",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11 <12",
      "onFail": "error"
    }
  },
  "exports": {
    "./release/v1/extractor": "./contracts/release/v1/tools/extract-inventory.mjs"
  },
  "files": [
    "dist/",
    "contracts/",
    "docs/honeybee.tmux.conf"
  ],
  "bin": {
    "hive": "dist/cli.js",
    "ap": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build-peercred.mjs --optional && node scripts/build-delivery-file.mjs --optional && node scripts/probe-peercred.mjs --optional && node scripts/probe-delivery-file.mjs --optional && node scripts/build-v2-artifact.mjs",
    "postbuild": "chmod +x dist/cli.js",
    "check": "npm run v2:check",
    "v2:check": "tsc -p v2/core/tsconfig.json && tsc -p v2/harness/tsconfig.json && tsc -p v2/adapters/tsconfig.json && tsc -p v2/driver-hsr/tsconfig.json && tsc -p v2/daemon/tsconfig.json && tsc -p v2/cli/tsconfig.json && tsc -p v2/driver-cell/tsconfig.json && tsc -p v2/driver-tmux/tsconfig.json",
    "v2:test": "NODE_COMPILE_CACHE=.cache/node-compile node scripts/with-fixture-warden.mjs node --test --test-isolation=none \"v2/core/tests/*.test.ts\" && node --test scripts/perf/fleet-cell.node-test.mjs scripts/perf/fleet-move.node-test.mjs",
    "v2:harness": "NODE_COMPILE_CACHE=.cache/node-compile node scripts/with-fixture-warden.mjs node --test --test-isolation=none \"v2/harness/tests/*.test.ts\"",
    "v2:harness:long": "HARNESS_PROFILE=long NODE_COMPILE_CACHE=.cache/node-compile node --test --test-isolation=none \"v2/harness/tests/*.test.ts\"",
    "v2:driver": "NODE_COMPILE_CACHE=.cache/node-compile node scripts/with-fixture-warden.mjs node --test \"v2/adapters/tests/*.test.ts\" \"v2/driver-hsr/tests/*.test.ts\"",
    "v2:driver2": "NODE_COMPILE_CACHE=.cache/node-compile node scripts/with-fixture-warden.mjs node --test \"v2/driver-cell/tests/*.test.ts\" \"v2/driver-tmux/tests/*.test.ts\"",
    "v2:daemon": "node scripts/with-fixture-warden.mjs node scripts/run-v2-daemon-tests.mjs",
    "v2:harness:real": "NODE_COMPILE_CACHE=.cache/node-compile node --test \"v2/driver-hsr/tests/harness/*.test.ts\" \"v2/driver-cell/tests/harness/*.test.ts\" \"v2/driver-tmux/tests/harness/*.test.ts\"",
    "deploy": "node scripts/deploy-settle.mjs",
    "hive": "node dist/cli.js",
    "v2:smoke": "node --experimental-strip-types v2/driver-hsr/smoke.ts",
    "v2:smoke:tmux": "node --experimental-strip-types v2/driver-tmux/smoke.ts",
    "v2:smoke:cell": "node --experimental-strip-types v2/driver-cell/smoke.ts",
    "release:inventory": "node contracts/release/v1/tools/extract-inventory.mjs .",
    "release:test": "node --test contracts/release/v1/tools/extract-inventory.test.mjs",
    "release:publish": "tsx scripts/publish-honeybee-release.mjs",
    "execution:digest": "node scripts/update-execution-digest.mjs",
    "runtime:artifact": "node scripts/build-runtime-artifact.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "esbuild": "0.27.7",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.67",
    "ajv": "^8.17.1",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.8.0",
    "tar": "7.5.11",
    "uuid": "^14.0.1"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
