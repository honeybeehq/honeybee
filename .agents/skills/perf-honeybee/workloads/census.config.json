{
  "version": 1,
  "$comment": "Bounded spawn census, two action reconciliation methods and batch action views; other core entry points remain outside the census.",
  "sourceRoots": [
    "v2/driver-cell/src",
    "v2/driver-hsr/src",
    "v2/daemon/src",
    "v2/cli/src",
    "v2/core/src"
  ],
  "extensions": "\\.ts$",
  "exclude": "(\\.test\\.|/tests/|/fixtures/)",
  "registries": [],
  "patterns": [
    {
      "inventory": "entry-points",
      "prefix": "entry:",
      "regex": "export (?:async )?function (\\w+)\\(",
      "mode": "capture",
      "keyTemplate": "{path}:{1}",
      "pathFilter": "^(?!v2/core/src/)"
    },
    {
      "inventory": "resource-owners",
      "prefix": "spawn:",
      "regex": "\\b(?:new Worker|spawn|spawnSync|execFile|execFileSync)\\(",
      "mode": "ordinal",
      "pathFilter": "^(?!v2/core/src/)"
    },
    {
      "inventory": "work-triggers",
      "prefix": "timer:",
      "regex": "\\b(?:setInterval|setTimeout)\\(",
      "mode": "ordinal",
      "pathFilter": "^(?!v2/core/src/)"
    },
    {
      "inventory": "boundaries",
      "prefix": "socket:",
      "regex": "\\b(?:createServer|createConnection|net\\.connect)\\(",
      "mode": "ordinal",
      "pathFilter": "^(?!v2/core/src/)"
    },
    {
      "inventory": "entry-points",
      "prefix": "action-poll:",
      "regex": "^  (reconcileArchiveAction|holdActionForExecutor)\\(",
      "flags": "m",
      "pathFilter": "^v2/core/src/store\\.ts$",
      "mode": "capture",
      "keyTemplate": "{1}"
    },
    {
      "inventory": "entry-points",
      "prefix": "action-view:",
      "regex": "^  (listActionViews)\\(",
      "flags": "m",
      "pathFilter": "^v2/core/src/store\\.ts$",
      "mode": "capture",
      "keyTemplate": "{1}"
    },
    {
      "inventory": "entry-points",
      "prefix": "runtime-read:",
      "regex": "^  (hasBootingRuntime)\\(",
      "flags": "m",
      "pathFilter": "^v2/core/src/store\\.ts$",
      "mode": "capture",
      "keyTemplate": "{1}"
    },
    {
      "inventory": "entry-points",
      "prefix": "account-activity:",
      "regex": "^  (nodeActivity)\\(",
      "flags": "m",
      "pathFilter": "^v2/daemon/src/accountsService\\.ts$",
      "mode": "capture",
      "keyTemplate": "{1}"
    }
  ]
}
