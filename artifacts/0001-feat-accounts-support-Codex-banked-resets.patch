+
+  constructor(code: "harness_mismatch" | "provider_outcome_uncertain" | "provider_unsupported" | "provider_refused", message: string) {
+    super(message);
+    this.name = "ResetLimitsRefusal";
+    this.code = code;
+  }
+}
